{
  "schemaVersion": "1.0",
  "assessment": {
    "title": "GCA Practice Fixture",
    "durationSeconds": 4200,
    "problems": [
      {
        "id": "p1",
        "slot": 1,
        "title": "Array Total",
        "generationMetadata": {
          "conceptSummary": "Sum all integers in an array.",
          "skills": ["arrays", "iteration"],
          "expectedComplexity": "O(n)",
          "patternTags": ["array traversal"]
        },
        "description": "Return the sum of all values in numbers.",
        "constraints": ["1 <= numbers.length <= 100000"],
        "signature": {
          "name": "solution",
          "parameters": [
            {
              "name": "numbers",
              "type": {
                "kind": "array",
                "items": { "kind": "int" }
              }
            }
          ],
          "returnType": { "kind": "int" }
        },
        "examples": [
          {
            "arguments": [[1, 2, 3]],
            "output": 6,
            "explanation": "The three values sum to 6."
          }
        ],
        "limits": {
          "executionTimeMs": 2000,
          "compileTimeMs": 10000,
          "outputLimitBytes": 65536
        },
        "tests": {
          "visible": [
            {
              "id": "p1-v1",
              "arguments": [[1, 2, 3]],
              "expected": 6,
              "category": "example"
            }
          ],
          "hidden": [
            {
              "id": "p1-h1",
              "arguments": [[-5, 5]],
              "expected": 0,
              "category": "boundary"
            }
          ]
        },
        "validation": {
          "referenceLanguage": "python",
          "referenceSolution": "def solution(numbers):\n    return sum(numbers)"
        }
      },
      {
        "id": "p2",
        "slot": 2,
        "title": "Mirror Text",
        "generationMetadata": {
          "conceptSummary": "Reverse a string without changing its characters.",
          "skills": ["strings"],
          "expectedComplexity": "O(n)",
          "patternTags": ["string transformation"]
        },
        "description": "Return text with its characters in reverse order.",
        "constraints": ["0 <= text.length <= 100000"],
        "signature": {
          "name": "solution",
          "parameters": [
            {
              "name": "text",
              "type": { "kind": "string" }
            }
          ],
          "returnType": { "kind": "string" }
        },
        "examples": [
          {
            "arguments": ["practice"],
            "output": "ecitcarp",
            "explanation": "Reading the input backward produces the result."
          }
        ],
        "limits": {
          "executionTimeMs": 2000,
          "compileTimeMs": 10000,
          "outputLimitBytes": 65536
        },
        "tests": {
          "visible": [
            {
              "id": "p2-v1",
              "arguments": ["practice"],
              "expected": "ecitcarp",
              "category": "example"
            }
          ],
          "hidden": [
            {
              "id": "p2-h1",
              "arguments": [""],
              "expected": "",
              "category": "boundary"
            }
          ]
        },
        "validation": {
          "referenceLanguage": "python",
          "referenceSolution": "def solution(text):\n    return text[::-1]"
        }
      },
      {
        "id": "p3",
        "slot": 3,
        "title": "Matrix Total",
        "generationMetadata": {
          "conceptSummary": "Accumulate every cell in a rectangular matrix.",
          "skills": ["matrices", "nested iteration"],
          "expectedComplexity": "O(rows * columns)",
          "patternTags": ["matrix traversal"]
        },
        "description": "Return the sum of every integer in matrix.",
        "constraints": ["1 <= matrix.length <= 1000"],
        "signature": {
          "name": "solution",
          "parameters": [
            {
              "name": "matrix",
              "type": {
                "kind": "array",
                "items": {
                  "kind": "array",
                  "items": { "kind": "int" }
                }
              }
            }
          ],
          "returnType": { "kind": "long" }
        },
        "examples": [
          {
            "arguments": [[[1, 2], [3, 4]]],
            "output": 10,
            "explanation": "The four cells sum to 10."
          }
        ],
        "limits": {
          "executionTimeMs": 2000,
          "compileTimeMs": 10000,
          "outputLimitBytes": 65536
        },
        "tests": {
          "visible": [
            {
              "id": "p3-v1",
              "arguments": [[[1, 2], [3, 4]]],
              "expected": 10,
              "category": "example"
            }
          ],
          "hidden": [
            {
              "id": "p3-h1",
              "arguments": [[[-2]]],
              "expected": -2,
              "category": "boundary"
            }
          ]
        },
        "validation": {
          "referenceLanguage": "python",
          "referenceSolution": "def solution(matrix):\n    return sum(sum(row) for row in matrix)"
        }
      },
      {
        "id": "p4",
        "slot": 4,
        "title": "All Flags Set",
        "generationMetadata": {
          "conceptSummary": "Determine whether every boolean flag is enabled.",
          "skills": ["arrays", "booleans"],
          "expectedComplexity": "O(n)",
          "patternTags": ["predicate"]
        },
        "description": "Return true exactly when every value in flags is true.",
        "constraints": ["1 <= flags.length <= 100000"],
        "signature": {
          "name": "solution",
          "parameters": [
            {
              "name": "flags",
              "type": {
                "kind": "array",
                "items": { "kind": "boolean" }
              }
            }
          ],
          "returnType": { "kind": "boolean" }
        },
        "examples": [
          {
            "arguments": [[true, true, false]],
            "output": false,
            "explanation": "One flag is not set."
          }
        ],
        "limits": {
          "executionTimeMs": 2000,
          "compileTimeMs": 10000,
          "outputLimitBytes": 65536
        },
        "tests": {
          "visible": [
            {
              "id": "p4-v1",
              "arguments": [[true, true, false]],
              "expected": false,
              "category": "example"
            }
          ],
          "hidden": [
            {
              "id": "p4-h1",
              "arguments": [[true]],
              "expected": true,
              "category": "boundary"
            }
          ]
        },
        "validation": {
          "referenceLanguage": "python",
          "referenceSolution": "def solution(flags):\n    return all(flags)"
        }
      }
    ]
  }
}
